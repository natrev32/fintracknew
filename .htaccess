# ============================================================
# Finance Tracker — konfigurasi Apache (Rumahweb / cPanel)
# Upload file ini ke public_html bersama index.html
# ============================================================

# Matikan listing direktori
Options -Indexes

# Paksa HTTPS — WAJIB: enkripsi vault (WebCrypto/AES-256) hanya
# berjalan di konteks aman; tanpa HTTPS aplikasi turun ke mode
# plaintext tanpa enkripsi.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{SERVER_PORT} 80
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Security headers (setara vercel.json)
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://discord.com https://discordapp.com https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# Halaman utama
DirectoryIndex index.html
